{
  "redirects": [
    {
      "source": "/author/omee00/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/author/omee00",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/category/divi-tips/page/:page/",
      "destination": "/blog/page/:page/",
      "permanent": true
    },
    {
      "source": "/category/divi-tips/",
      "destination": "/blog/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*\\.(js|css|png|jpg|jpeg|webp|avif|svg|woff2))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
