---
import BaseLayout from './BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';

export interface Props {
  title: string;
  description: string;
  date: Date;
  updated?: Date;
  category?: string;
  featuredImage?: string;
  ogImage?: string;
  slug: string;
  readingTime?: string;
  hasFAQ?: boolean;
  faqData?: { question: string; answer: string }[];
}

const {
  title,
  description,
  date,
  updated,
  category = 'Divi Tips',
  featuredImage,
  ogImage,
  slug,
  readingTime = '4 min read',
  hasFAQ = false,
  faqData = [],
} = Astro.props;

const siteUrl = 'https://www.dividesignpro.com';
const postUrl = `${siteUrl}/blog/${slug}/`;
const isoDate = date.toISOString();
const isoUpdated = updated ? updated.toISOString() : isoDate;
const ogImageUrl = ogImage || featuredImage || `${siteUrl}/og-images/default-og.svg`;

const breadcrumbItems = [
  { name: 'Home', url: siteUrl },
  { name: 'Blog', url: `${siteUrl}/blog/` },
  { name: title, url: postUrl },
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={postUrl}
  ogImage={ogImageUrl}
  ogType="article"
  publishedTime={isoDate}
  modifiedTime={isoUpdated}
>
  <article class="blog-post">
    <header class="blog-post__header">
      <div class="container">
        {category && (
          <a href={`/category/${category.toLowerCase().replace(/\s+/g, '-')}/`} class="blog-post__category">
            {category}
          </a>
        )}
        <h1 class="blog-post__title">{title}</h1>
        <div class="blog-post__meta">
          <time datetime={isoDate}>
            {date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
          <span class="blog-post__meta-sep">·</span>
          <span>by <strong>Muhammad Omar Farooq</strong></span>
          <span class="blog-post__meta-sep">·</span>
          <span>{readingTime}</span>
          {updated && updated.getTime() !== date.getTime() && (
            <>
              <span class="blog-post__meta-sep">·</span>
              <span class="blog-post__updated">Updated <time datetime={isoUpdated}>{updated.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</time></span>
            </>
          )}
        </div>
        {featuredImage && (
          <img
            src={featuredImage}
            alt={title}
            class="blog-post__featured-img"
            width="800"
            height="450"
            loading="eager"
            decoding="async"
          />
        )}
      </div>
    </header>

    <div class="container blog-post__body">
      <!-- Table of Contents -->
      <nav class="toc" aria-label="Table of Contents">
        <h2 class="toc__title">In this article</h2>
        <ol class="toc__list" id="toc-list">
          <!-- Populated by JS -->
        </ol>
      </nav>

      <div class="blog-post__content" id="post-content">
        <slot />
      </div>

      <!-- Author bio -->
      <div class="author-bio">
        <div class="author-bio__avatar" aria-hidden="true">MO</div>
        <div class="author-bio__info">
          <h3 class="author-bio__name">Muhammad Omar Farooq</h3>
          <p class="author-bio__text">
            Freelance Divi designer and WordPress developer with a Master's in Computer Science and 10+ years of experience. Built 100+ Divi websites across industries. Specializes in Divi 5, performance optimization, and on-page SEO.
          </p>
          <div class="author-bio__links">
            <a href="https://www.linkedin.com/in/muhammad-omar-farooq-wp/" target="_blank" rel="noopener">LinkedIn</a>
            <a href="mailto:omee00@gmail.com">Email</a>
            <a href="/#contact">Hire Me</a>
          </div>
        </div>
      </div>
    </div>
  </article>

  <JsonLd
    type="Article"
    data={{
      title,
      description,
      image: ogImageUrl,
      datePublished: isoDate,
      dateModified: isoUpdated,
      url: postUrl,
    }}
  />

  <JsonLd
    type="BreadcrumbList"
    data={{ items: breadcrumbItems }}
  />

  {hasFAQ && faqData.length > 0 && (
    <JsonLd
      type="FAQ"
      data={{ questions: faqData }}
    />
  )}
</BaseLayout>

<style>
  .blog-post {
    padding-top: calc(var(--header-height) + var(--space-10));
    padding-bottom: var(--space-16);
  }

  .blog-post__header {
    text-align: center;
    padding-bottom: var(--space-8);
    margin-bottom: var(--space-8);
    border-bottom: 1px solid var(--color-gray-100);
  }

  .blog-post__category {
    display: inline-block;
    background-color: var(--color-primary-light);
    color: var(--color-primary);
    font-size: var(--text-sm);
    font-weight: 600;
    padding: var(--space-1) var(--space-3);
    border-radius: 999px;
    margin-bottom: var(--space-4);
    text-decoration: none;
  }

  .blog-post__title {
    max-width: 800px;
    margin-inline: auto;
    margin-bottom: var(--space-4);
  }

  .blog-post__meta {
    color: var(--color-gray-500);
    font-size: var(--text-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-1);
    flex-wrap: wrap;
  }

  .blog-post__meta-sep {
    margin-inline: var(--space-1);
  }

  .blog-post__updated {
    color: var(--color-gray-400);
    font-style: italic;
  }

  .blog-post__featured-img {
    max-width: 800px;
    margin-inline: auto;
    margin-top: var(--space-6);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-lg);
    width: 100%;
    height: auto;
  }

  .blog-post__body {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* ===== Table of Contents ===== */
  .toc {
    background-color: var(--color-gray-50);
    border: 1px solid var(--color-gray-100);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    margin-bottom: var(--space-8);
    max-width: 720px;
    width: 100%;
  }

  .toc__title {
    font-size: var(--text-sm);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-gray-700);
    margin-bottom: var(--space-3);
  }

  .toc__list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    counter-reset: toc;
  }

  .toc__list li {
    counter-increment: toc;
  }

  .toc__list a {
    display: block;
    padding: var(--space-1) var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-gray-600);
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition: all var(--transition-fast);
  }

  .toc__list a:hover {
    color: var(--color-primary);
    background-color: var(--color-primary-light);
  }

  /* ===== Content ===== */
  .blog-post__content {
    max-width: 720px;
    width: 100%;
  }

  .blog-post__content :global(h2) {
    margin-top: var(--space-12);
    margin-bottom: var(--space-4);
    font-size: var(--text-3xl);
  }

  .blog-post__content :global(h3) {
    margin-top: var(--space-8);
    margin-bottom: var(--space-3);
    font-size: var(--text-xl);
  }

  .blog-post__content :global(p) {
    margin-bottom: var(--space-4);
    line-height: 1.8;
  }

  .blog-post__content :global(ul),
  .blog-post__content :global(ol) {
    margin-bottom: var(--space-4);
    padding-left: var(--space-6);
  }

  .blog-post__content :global(li) {
    margin-bottom: var(--space-2);
  }

  .blog-post__content :global(pre) {
    background-color: var(--color-gray-900);
    color: var(--color-gray-100);
    padding: var(--space-4);
    border-radius: var(--radius-lg);
    overflow-x: auto;
    margin-bottom: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .blog-post__content :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background-color: var(--color-gray-100);
    padding: 0.15em 0.4em;
    border-radius: var(--radius-sm);
  }

  .blog-post__content :global(pre code) {
    background-color: transparent;
    padding: 0;
  }

  .blog-post__content :global(blockquote) {
    border-left: 4px solid var(--color-primary);
    padding-left: var(--space-4);
    margin-bottom: var(--space-4);
    color: var(--color-gray-600);
    font-style: italic;
  }

  .blog-post__content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: var(--space-4);
    font-size: var(--text-sm);
  }

  .blog-post__content :global(th) {
    background-color: var(--color-gray-900);
    color: var(--color-white);
    padding: var(--space-3) var(--space-4);
    text-align: left;
    font-weight: 600;
  }

  .blog-post__content :global(td) {
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-gray-200);
  }

  .blog-post__content :global(figure) {
    margin-bottom: var(--space-4);
  }

  /* ===== Author Bio ===== */
  .author-bio {
    max-width: 720px;
    width: 100%;
    margin-top: var(--space-12);
    padding: var(--space-6);
    background-color: var(--color-gray-50);
    border: 1px solid var(--color-gray-100);
    border-radius: var(--radius-xl);
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
  }

  .author-bio__avatar {
    width: 56px;
    height: 56px;
    min-width: 56px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-primary), #D4743B);
    color: var(--color-white);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: var(--text-lg);
  }

  .author-bio__name {
    font-size: var(--text-base);
    margin-bottom: var(--space-1);
  }

  .author-bio__text {
    font-size: var(--text-sm);
    color: var(--color-gray-600);
    line-height: 1.6;
    margin-bottom: var(--space-3);
  }

  .author-bio__links {
    display: flex;
    gap: var(--space-3);
  }

  .author-bio__links a {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-primary);
  }

  @media (max-width: 768px) {
    .author-bio {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .author-bio__links {
      justify-content: center;
    }
  }
</style>

<script>
  // Auto-generate Table of Contents from H2s in the post
  const content = document.getElementById('post-content');
  const tocList = document.getElementById('toc-list');
  if (content && tocList) {
    const h2s = content.querySelectorAll('h2');
    h2s.forEach(function(h2, index) {
      // Add ID to each H2 for anchor linking
      const id = 'section-' + (index + 1);
      h2.setAttribute('id', id);

      // Add ToC entry
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.setAttribute('href', '#' + id);
      a.textContent = h2.textContent;
      li.appendChild(a);
      tocList.appendChild(li);
    });

    // Hide ToC if fewer than 3 sections
    if (h2s.length < 3) {
      tocList.parentElement.style.display = 'none';
    }
  }
</script>
