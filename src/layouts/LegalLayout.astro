---
import BaseLayout from './BaseLayout.astro';
import { business, addressLines } from '../data/business';

export interface LegalSection {
  id: string;
  heading: string;
  body?: string[];
  list?: string[];
}

export interface Props {
  title: string;
  description: string;
  badge: string;
  intro: string;
  sections: LegalSection[];
  effectiveDate?: string;
}

const { title, description, badge, intro, sections, effectiveDate = business.effectiveDate } = Astro.props;

const address = addressLines();
---

<BaseLayout title={title} description={description}>
  <section class="page-header">
    <div class="container">
      <span class="page-header__badge">{badge}</span>
      <h1 class="page-header__title">{title}</h1>
      <p class="page-header__desc">{intro}</p>
      <p class="page-header__updated">Last updated: {effectiveDate}</p>
    </div>
  </section>

  <section class="section">
    <div class="container legal">
      <nav class="legal__toc" aria-label="On this page">
        <h2 class="legal__toc-title">On this page</h2>
        <ol class="legal__toc-list">
          {sections.map((section) => (
            <li><a href={`#${section.id}`}>{section.heading}</a></li>
          ))}
        </ol>
      </nav>

      <div class="legal__body">
        {sections.map((section) => (
          <article class="legal__section" id={section.id}>
            <h2 class="legal__heading">{section.heading}</h2>
            {section.body?.map((paragraph) => (
              <p class="legal__para" set:html={paragraph} />
            ))}
            {section.list && (
              <ul class="legal__list">
                {section.list.map((item) => (
                  <li set:html={item} />
                ))}
              </ul>
            )}
          </article>
        ))}

        <aside class="legal__identity" id="business-details">
          <h2 class="legal__identity-title">Business details</h2>
          <p class="legal__identity-lead">
            This website is operated by {business.legalName}, trading as {business.tradingAs}.
          </p>
          <dl class="legal__identity-list">
            <dt>Legal name</dt>
            <dd>{business.legalName}</dd>
            <dt>Trading name</dt>
            <dd>{business.tradingAs}</dd>
            <dt>Registered address</dt>
            <dd>
              {address.map((line) => <span class="legal__identity-line">{line}</span>)}
            </dd>
            <dt>Email</dt>
            <dd><a href={`mailto:${business.email}`}>{business.email}</a></dd>
            <dt>Telephone — Pakistan</dt>
            <dd><a href={`tel:${business.phoneLocal.href}`}>{business.phoneLocal.display}</a></dd>
            <dt>Telephone — international</dt>
            <dd><a href={`tel:${business.phoneInternational.href}`}>{business.phoneInternational.display}</a></dd>
          </dl>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-header {
    padding-top: calc(var(--header-height) + var(--space-12));
    padding-bottom: var(--space-10);
    background: linear-gradient(180deg, #EEF2FF 0%, #FFFFFF 100%);
    text-align: center;
  }

  .page-header__badge {
    display: inline-block;
    background-color: var(--color-accent-light);
    color: var(--color-accent-dark);
    font-size: var(--text-sm);
    font-weight: 600;
    padding: var(--space-1) var(--space-3);
    border-radius: 999px;
    margin-bottom: var(--space-3);
  }

  .page-header__title { margin-bottom: var(--space-4); }

  .page-header__desc {
    max-width: 680px;
    margin-inline: auto;
    color: var(--color-text-secondary);
    font-size: var(--text-lg);
    line-height: 1.7;
  }

  .page-header__updated {
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .legal {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: var(--space-12);
    align-items: start;
  }

  .legal__toc {
    position: sticky;
    top: calc(var(--header-height) + var(--space-6));
    background: var(--color-surface-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
  }

  .legal__toc-title {
    font-size: var(--text-sm);
    font-weight: 600;
    font-family: var(--font-body);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
  }

  .legal__toc-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    counter-reset: toc;
  }

  .legal__toc-list li { counter-increment: toc; }

  .legal__toc-list a {
    display: block;
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    text-decoration: none;
    line-height: 1.5;
    transition: color var(--transition-fast);
  }

  .legal__toc-list a::before {
    content: counter(toc) '. ';
    color: var(--color-text-muted);
  }

  .legal__toc-list a:hover { color: var(--color-primary); }

  .legal__body {
    max-width: 72ch;
  }

  .legal__section { margin-bottom: var(--space-10); }

  .legal__section:target .legal__heading { color: var(--color-primary); }

  .legal__heading {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-4);
    scroll-margin-top: calc(var(--header-height) + var(--space-6));
    scroll-margin-bottom: var(--space-10);
  }

  .legal__para {
    color: var(--color-text-secondary);
    line-height: 1.75;
    margin-bottom: var(--space-4);
  }

  .legal__para:last-child { margin-bottom: 0; }

  .legal__para :global(a),
  .legal__list :global(a) {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .legal__list {
    list-style: disc;
    padding-left: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .legal__list li {
    color: var(--color-text-secondary);
    line-height: 1.75;
  }

  .legal__identity {
    margin-top: var(--space-12);
    background: var(--color-surface-alt);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-primary);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
  }

  .legal__identity-title {
    font-size: var(--text-xl);
    margin-bottom: var(--space-3);
  }

  .legal__identity-lead {
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin-bottom: var(--space-6);
  }

  .legal__identity-list {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: var(--space-2) var(--space-6);
    font-size: var(--text-sm);
  }

  .legal__identity-list dt {
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .legal__identity-list dd {
    color: var(--color-text);
    margin: 0;
  }

  .legal__identity-line { display: block; }

  .legal__identity-list a {
    color: var(--color-primary);
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .legal__identity-list a:hover { text-decoration: underline; }

  @media (max-width: 900px) {
    .legal { grid-template-columns: 1fr; gap: var(--space-8); }
    .legal__toc { position: static; }
    .legal__identity-list { grid-template-columns: 1fr; gap: var(--space-1); }
    .legal__identity-list dd { margin-bottom: var(--space-3); }
  }
</style>
