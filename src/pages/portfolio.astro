---
import BaseLayout from '../layouts/BaseLayout.astro';
import Portfolio from '../components/Portfolio.astro';
---

<BaseLayout
  title="Portfolio | Divi Website Projects"
  description="50+ Divi websites across outdoor advertising, dental, construction, weddings, freight logistics, plumbing, chimney services, education, and adventure. Custom-designed, SEO-optimized."
  ogImage="/og-images/portfolio-og.png"
>
  <section class="page-header">
    <div class="container">
      <h1 class="page-header__title">Portfolio</h1>
      <p class="page-header__desc">
        I have built 50+ Divi websites across industries including outdoor advertising,
        dental, construction, guided tours, music, life coaching, AI chatbots, weddings,
        freight logistics, plumbing, home construction, painting, chimney services,
        education, and adventure. Every site is custom-designed, mobile-responsive,
        speed-optimized, and SEO-ready. Want a site like these? Get in touch.
      </p>
    </div>
  </section>

  <Portfolio />
</BaseLayout>

<style>
  .page-header {
    padding-top: calc(var(--header-height) + var(--space-12));
    padding-bottom: var(--space-10);
    background: linear-gradient(180deg, #EFF6FF 0%, #FFFFFF 100%);
    text-align: center;
  }

  .page-header__title {
    margin-bottom: var(--space-4);
  }

  .page-header__desc {
    max-width: 720px;
    margin-inline: auto;
    color: var(--color-text-secondary);
    font-size: var(--text-lg);
    line-height: 1.7;
  }
</style>
