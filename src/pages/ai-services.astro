---
import BaseLayout from '../layouts/BaseLayout.astro';

const aiProjects = [
  {
    title: 'CaseWalay',
    url: 'https://casewalay.com',
    description: 'Premium phone cases e-commerce store in Pakistan. Built end-to-end with AI — from design generation to production deployment on Vercel.',
    tech: 'AI Design, Astro, Vercel, WhatsApp API',
    image: '/portfolio/casewalay.webp',
  },
  {
    title: 'BazaarNow',
    url: 'https://bazaarnow.net',
    description: 'Multi-vendor marketplace platform. Complex architecture with AI-powered product categorization and search.',
    tech: 'AI Design, Astro, Supabase, Vercel',
    image: '/portfolio/ai-project-3.webp',
  },
  {
    title: 'Custom Designs Now',
    url: 'https://customdesignsnow.com',
    description: 'Custom merchandise e-commerce platform. AI-generated product mockups and complete storefront built with AI assistance.',
    tech: 'AI Design, WordPress, WooCommerce, Vercel',
    image: '/portfolio/ai-project-2.webp',
  },
  {
    title: 'Veloxa Agency',
    url: 'https://veloxa.agency',
    description: 'Modern digital marketing agency website. AI-generated design, custom responsive layout, and full SEO optimization.',
    tech: 'AI Design, Astro, Vercel',
    image: '/portfolio/ai-project-4.webp',
  },
];
---

<BaseLayout
  title="AI-Powered Web Development | From Design to Deployment"
  description="I build complete websites and SaaS tools using AI — from design generation to production deployment on Vercel. CaseWalay, GrantCashFlow, Veloxa, and more."
  ogImage="/og-images/default-og.svg"
>
  <section class="page-header">
    <div class="container">
      <span class="page-header__badge">AI + Human Expertise</span>
      <h1 class="page-header__title">AI-Powered Web Development</h1>
      <p class="page-header__desc">
        I use AI to design, build, and deploy complete websites — from concept to production.
        Combining AI speed with human expertise, I deliver sites faster without sacrificing quality.
        Every site below was built with AI assistance and deployed on Vercel.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section__header">
        <h2 class="section__title">AI-Built Projects</h2>
        <p class="section__subtitle">
          Real websites and SaaS tools built using AI for design, content, and development.
          Each project demonstrates what's possible when you combine AI generation with professional oversight.
        </p>
      </div>

      <div class="ai-grid">
        {aiProjects.map((project) => (
          <a href={project.url} target="_blank" rel="noopener noreferrer" class="ai-card">
            <div class="ai-card__image">
              <img
                src={project.image}
                alt={`${project.title} — ${project.description}`}
                loading="lazy"
                decoding="async"
                width="640"
                height="400"
              />
            </div>
            <div class="ai-card__body">
              <h3 class="ai-card__title">{project.title}</h3>
              <p class="ai-card__desc">{project.description}</p>
              <div class="ai-card__tech">
                {project.tech.split(', ').map((t) => (
                  <span class="ai-card__tag">{t}</span>
                ))}
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="saas-highlight">
        <div class="saas-highlight__content">
          <span class="saas-highlight__badge">SaaS Development</span>
          <h2 class="saas-highlight__title">I Also Build SaaS Tools</h2>
          <p class="saas-highlight__text">
            <strong>GrantCashFlow</strong> is an AI-powered grant writing platform for nonprofits.
            I built the entire application — frontend, backend, authentication, payments, and AI integration —
            using modern tools and AI assistance.
          </p>
          <ul class="saas-highlight__list">
            <li>AI content generation for grant proposals</li>
            <li>Supabase backend with real-time database</li>
            <li>Stripe payment integration</li>
            <li>User authentication and team management</li>
            <li>Deployed on Vercel with CI/CD</li>
          </ul>
          <a href="https://grantcashflow.com" target="_blank" rel="noopener" class="btn btn--primary btn--lg">
            Visit GrantCashFlow
          </a>
        </div>
        <div class="saas-highlight__image">
          <img
            src="/portfolio/ai-project-1.webp"
            alt="GrantCashFlow — AI Grant Writing SaaS"
            loading="lazy"
            decoding="async"
            width="600"
            height="400"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section__header">
        <h2 class="section__title">My AI Workflow</h2>
        <p class="section__subtitle">
          Here's how I use AI to build websites faster without compromising on quality.
        </p>
      </div>

      <div class="workflow-grid">
        <div class="workflow-step">
          <div class="workflow-step__num">1</div>
          <h3>AI Design Generation</h3>
          <p>I use Claude, Lovable, and other AI tools to generate initial designs and layouts. This gives us a strong visual direction in hours instead of days.</p>
        </div>
        <div class="workflow-step">
          <div class="workflow-step__num">2</div>
          <h3>Human Refinement</h3>
          <p>AI designs need professional oversight. I refine layouts, fix responsiveness, optimize for performance, and ensure accessibility standards are met.</p>
        </div>
        <div class="workflow-step">
          <div class="workflow-step__num">3</div>
          <h3>Development & Integration</h3>
          <p>Converting designs into production code — whether Astro static sites, Supabase backends, or WordPress installations. AI assists but human expertise leads.</p>
        </div>
        <div class="workflow-step">
          <div class="workflow-step__num">4</div>
          <h3>Deploy on Vercel</h3>
          <p>Every site is deployed on Vercel with automatic CI/CD, SSL, global CDN, and instant rollbacks. Zero-downtime deployments every time.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container" style="text-align:center;">
      <h2 class="section__title">Want an AI-Built Site?</h2>
      <p class="section__subtitle" style="margin-bottom:var(--space-6);">
        I can build your website or SaaS tool using AI — from design to deployment. Faster delivery, lower cost, same professional quality.
      </p>
      <a href="/#contact" class="btn btn--primary btn--lg">Get a Free Quote</a>
    </div>
  </section>
</BaseLayout>

<style>
  .page-header {
    padding-top: calc(var(--header-height) + var(--space-12));
    padding-bottom: var(--space-10);
    background: linear-gradient(180deg, #EFF6FF 0%, #FFFFFF 100%);
    text-align: center;
  }

  .page-header__badge {
    display: inline-block;
    background-color: var(--color-accent-light);
    color: var(--color-accent-dark);
    font-size: var(--text-sm);
    font-weight: 600;
    padding: var(--space-1) var(--space-3);
    border-radius: 999px;
    margin-bottom: var(--space-3);
  }

  .page-header__title { margin-bottom: var(--space-4); }

  .page-header__desc {
    max-width: 640px;
    margin-inline: auto;
    color: var(--color-text-secondary);
    font-size: var(--text-lg);
    line-height: 1.7;
  }

  .ai-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6);
  }

  .ai-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: all var(--transition-base);
  }

  .ai-card:hover {
    border-color: var(--color-primary-light);
    box-shadow: var(--shadow-lg);
    transform: translateY(-2px);
  }

  .ai-card__image {
    aspect-ratio: 16 / 10;
    background: var(--color-surface-alt);
    overflow: hidden;
  }

  .ai-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .ai-card:hover .ai-card__image img { transform: scale(1.03); }

  .ai-card__body { padding: var(--space-5); }

  .ai-card__title {
    font-size: var(--text-xl);
    margin-bottom: var(--space-2);
  }

  .ai-card__desc {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-4);
  }

  .ai-card__tech { display: flex; gap: var(--space-2); flex-wrap: wrap; }

  .ai-card__tag {
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--color-primary);
    background: var(--color-primary-light);
    padding: var(--space-1) var(--space-2);
    border-radius: 999px;
  }

  .saas-highlight {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-10);
    align-items: center;
  }

  .saas-highlight__badge {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-primary);
    margin-bottom: var(--space-2);
  }

  .saas-highlight__title { margin-bottom: var(--space-4); }

  .saas-highlight__text {
    color: var(--color-text-secondary);
    margin-bottom: var(--space-4);
  }

  .saas-highlight__list {
    padding-left: var(--space-5);
    margin-bottom: var(--space-6);
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
  }

  .saas-highlight__list li { margin-bottom: var(--space-2); }

  .saas-highlight__image img {
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-lg);
    width: 100%;
  }

  .workflow-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-6);
  }

  .workflow-step {
    text-align: center;
    padding: var(--space-5);
  }

  .workflow-step__num {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--color-primary);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    margin: 0 auto var(--space-4);
  }

  .workflow-step h3 {
    font-size: var(--text-base);
    margin-bottom: var(--space-2);
  }

  .workflow-step p {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  @media (max-width: 1024px) {
    .workflow-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 768px) {
    .ai-grid { grid-template-columns: 1fr; }
    .saas-highlight { grid-template-columns: 1fr; }
    .workflow-grid { grid-template-columns: 1fr; }
  }
</style>
