---
import BaseLayout from '../layouts/BaseLayout.astro';

interface PricingTier {
  name: string;
  description: string;
  price: string;
  period?: string;
  popular?: boolean;
  features: string[];
  cta: string;
}

const pricingTabs = [
  { id: 'design', label: 'Web Design' },
  { id: 'ai-conversion', label: 'AI-to-Divi' },
  { id: 'maintenance', label: 'Maintenance' },
];

const pricingData: Record<string, PricingTier[]> = {
  design: [
    {
      name: 'Starter',
      description: 'A professional 5-page Divi website for small businesses, startups, or personal brands.',
      price: '$799',
      features: [
        '5-Page Custom Divi Website',
        'Mobile-Responsive Design',
        'Contact Form Integration',
        'Basic On-Page SEO',
        'Social Media Links',
        'Google Analytics Setup',
        '2 Revision Rounds',
        '1-Week Delivery',
      ],
      cta: 'Get Started',
    },
    {
      name: 'Professional',
      description: 'A complete custom Divi website with advanced features, SEO, and speed optimization.',
      price: '$1,799',
      popular: true,
      features: [
        '10-Page Custom Divi Website',
        'Mobile-Responsive Design',
        'Advanced On-Page SEO',
        'Speed Optimization (90+ Lighthouse)',
        'Blog Setup (5 Posts)',
        'Contact Form + CRM Integration',
        'Social Media Integration',
        'Google Analytics + Search Console',
        'Custom 404 Page',
        '3 Revision Rounds',
        '2-Week Delivery',
      ],
      cta: 'Choose Professional',
    },
    {
      name: 'E-Commerce',
      description: 'Full Divi + WooCommerce online store with product setup and payment integration.',
      price: '$2,999',
      features: [
        'Custom Divi + WooCommerce Store',
        'Up to 50 Product Listings',
        'Payment Gateway Setup (Stripe/PayPal)',
        'Shipping & Tax Configuration',
        'Inventory Management',
        'Mobile-Responsive Design',
        'Advanced SEO for Products',
        'Speed Optimization (85+ Lighthouse)',
        'Order Confirmation Emails',
        '3 Revision Rounds',
        '3-4 Week Delivery',
      ],
      cta: 'Start E-Commerce',
    },
  ],
  'ai-conversion': [
    {
      name: 'Quick Convert',
      description: 'Your AI-generated design converted into a single-page Divi landing page.',
      price: '$399',
      features: [
        'AI Design → Divi Landing Page',
        'Pixel-Accurate Conversion',
        'Mobile-Responsive',
        'Contact Form Integration',
        'Basic SEO Setup',
        '1 Revision Round',
        '3-Day Delivery',
      ],
      cta: 'Convert My Design',
    },
    {
      name: 'Full Convert',
      description: 'Your AI design rebuilt as a complete multipage WordPress site with all features.',
      price: '$999',
      popular: true,
      features: [
        'AI Design → Full Divi Website',
        'Up to 10 Pages',
        'Pixel-Accurate Conversion',
        'Mobile-Responsive Design',
        'Blog Integration',
        'Contact Forms + CRM',
        'On-Page SEO',
        'Speed Optimization',
        '2 Revision Rounds',
        '1-Week Delivery',
      ],
      cta: 'Convert My Design',
    },
    {
      name: 'AI + Custom',
      description: 'AI design converted and enhanced with custom functionality tailored to your business.',
      price: '$1,699',
      features: [
        'AI Design → Custom Divi Website',
        'Unlimited Pages',
        'Custom Post Types',
        'Advanced WooCommerce / LMS / Membership',
        'Custom Plugin Integration',
        'Full SEO + Speed Optimization',
        'Analytics + Heatmaps',
        '3 Revision Rounds',
        '2-Week Delivery',
      ],
      cta: 'Go Custom',
    },
  ],
  maintenance: [
    {
      name: 'Basic Care',
      description: 'Essential maintenance to keep your Divi site secure, updated, and running smoothly.',
      price: '$99',
      period: '/mo',
      features: [
        'WordPress Core Updates',
        'Divi Theme Updates',
        'Plugin Updates',
        'Daily Backups',
        'Uptime Monitoring',
        'Security Scanning',
        '30-Min Monthly Edits',
        'Email Support',
      ],
      cta: 'Start Basic Care',
    },
    {
      name: 'Growth',
      description: 'Ongoing maintenance plus content updates and SEO monitoring for growing businesses.',
      price: '$199',
      period: '/mo',
      popular: true,
      features: [
        'Everything in Basic Care',
        '2 Hours Monthly Content Edits',
        'Monthly SEO Report',
        'Keyword Ranking Tracker',
        'Google Analytics Reporting',
        'Image Optimization',
        'Broken Link Monitoring',
        'Priority Email Support',
      ],
      cta: 'Start Growth',
    },
    {
      name: 'Premium',
      description: 'Full-service maintenance with unlimited edits, CRO, and dedicated support for high-traffic sites.',
      price: '$399',
      period: '/mo',
      features: [
        'Everything in Growth',
        '4 Hours Monthly Content Edits',
        'Conversion Rate Optimization',
        'A/B Testing Setup',
        'Advanced Speed Tuning',
        'Weekly SEO Check-ins',
        'Monthly Strategy Call',
        'Dedicated Slack/WhatsApp Support',
      ],
      cta: 'Start Premium',
    },
  ],
};

const addOns = [
  { name: 'Extra Page', price: '$75' },
  { name: 'Blog Post (written + formatted)', price: '$50' },
  { name: 'Logo Design', price: '$150' },
  { name: 'Speed Optimization (existing site)', price: '$250' },
  { name: 'SEO Audit + Fixes', price: '$350' },
  { name: 'Social Media Integration', price: '$75' },
  { name: 'Live Chat Integration', price: '$100' },
  { name: 'Payment Gateway Setup', price: '$150' },
];
---

<BaseLayout
  title="Transparent Pricing | Divi Web Design Packages"
  description="Value-driven Divi design packages for businesses of all sizes. Websites from $799, AI-to-Divi conversion from $399, maintenance from $99/mo. No hidden fees."
  ogImage="/og-images/default-og.png"
>
  <!-- Hero -->
  <section class="page-header">
    <div class="container">
      <span class="page-header__badge">Transparent</span>
      <h1 class="page-header__title">Transparent Pricing</h1>
      <p class="page-header__desc">
        Value-driven packages tailored for businesses of all sizes.
        No hidden fees, no surprises — just great work at fair prices.
      </p>
    </div>
  </section>

  <!-- Pricing Tabs -->
  <section class="section" id="pricing-tabs">
    <div class="container">
      <div class="pricing-tabs" role="tablist">
        {pricingTabs.map((tab, i) => (
          <button
            class={`pricing-tab ${i === 0 ? 'pricing-tab--active' : ''}`}
            role="tab"
            data-tab={tab.id}
          >
            {tab.label}
          </button>
        ))}
      </div>

      {pricingTabs.map((tab, tabIndex) => (
        <div class={`pricing-grid ${tabIndex === 0 ? '' : 'pricing-grid--hidden'}`} data-tab-content={tab.id}>
          {pricingData[tab.id].map((tier) => (
            <div class={`pricing-card ${tier.popular ? 'pricing-card--popular' : ''}`}>
              {tier.popular && <span class="pricing-card__badge">Most Popular</span>}
              <h3 class="pricing-card__name">{tier.name}</h3>
              <p class="pricing-card__desc">{tier.description}</p>
              <div class="pricing-card__price">
                <span class="pricing-card__amount">{tier.price}</span>
                {tier.period && <span class="pricing-card__period">{tier.period}</span>}
              </div>
              <a href="/#contact" class="btn btn--primary btn--lg pricing-card__cta">
                {tier.cta}
              </a>
              <div class="pricing-card__features">
                <p class="pricing-card__features-title">What's Included</p>
                <ul class="pricing-card__features-list">
                  {tier.features.map((feature) => (
                    <li>
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="20 6 9 17 4 12"/>
                      </svg>
                      {feature}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ))}
        </div>
      ))}
    </div>
  </section>

  <!-- Add-ons -->
  <section class="section section--alt">
    <div class="container">
      <div class="addons">
        <span class="addons__label">Add-ons</span>
        <h2 class="addons__title">Need something extra?</h2>
        <p class="addons__subtitle">
          Customize any package with these add-on services.
        </p>
        <div class="addons__grid">
          {addOns.map((addon) => (
            <div class="addon-item">
              <span class="addon-item__name">{addon.name}</span>
              <span class="addon-item__price">{addon.price}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Policies -->
  <section class="section">
    <div class="container">
      <div class="policies">
        <span class="policies__label">Policies</span>
        <h2 class="policies__title">How I Work</h2>
        <div class="policies__grid">
          <div class="policy-card">
            <h4 class="policy-card__title">Payment</h4>
            <p class="policy-card__text">
              50% upfront to start the project, 50% upon completion and before final delivery.
              All payments via bank transfer, credit card, or Wise.
            </p>
          </div>
          <div class="policy-card">
            <h4 class="policy-card__title">Revisions</h4>
            <p class="policy-card__text">
              Each package includes the stated revision rounds. Additional revisions beyond the
              included rounds are billed at $50/hour.
            </p>
          </div>
          <div class="policy-card">
            <h4 class="policy-card__title">Support</h4>
            <p class="policy-card__text">
              Standard email support included for 30 days after launch. Extended support available
              through maintenance plans.
            </p>
          </div>
          <div class="policy-card">
            <h4 class="policy-card__title">Ownership</h4>
            <p class="policy-card__text">
              Upon full payment, you own everything — designs, code, content, and all assets.
              No lock-in. No hidden licensing fees.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section--alt">
    <div class="container">
      <div class="faq-section">
        <span class="faq-section__label">FAQ</span>
        <h2 class="faq-section__title">Frequently Asked Questions</h2>
        <div class="faq-section__grid">
          <details class="faq-item">
            <summary class="faq-item__question">What's included in a "page"?</summary>
            <p class="faq-item__answer">
              A page is any distinct URL on your site — Home, About, Services, Contact, etc.
              Each page includes custom Divi layouts, mobile responsiveness, and basic SEO.
              Blog posts and product pages are counted separately.
            </p>
          </details>
          <details class="faq-item">
            <summary class="faq-item__question">How long does a typical project take?</summary>
            <p class="faq-item__answer">
              Starter sites: 1 week. Professional sites: 2 weeks. E-commerce: 3-4 weeks.
              AI-to-Divi conversions: 3-7 days. Timelines assume you provide content
              promptly — delays in content delivery will push the timeline.
            </p>
          </details>
          <details class="faq-item">
            <summary class="faq-item__question">Do you provide content and images?</summary>
            <p class="faq-item__answer">
              Content (text, images, branding) is your responsibility. I can recommend
              stock photo sources and provide copywriting as an add-on service. I'm happy
              to advise on content structure as part of the design process.
            </p>
          </details>
          <details class="faq-item">
            <summary class="faq-item__question">Can I edit the site myself after it's built?</summary>
            <p class="faq-item__answer">
              Absolutely. Every site is built with Divi's visual builder, so you can update
              text, images, and layouts without touching code. I'll also provide a quick
              video walkthrough of how to manage your site.
            </p>
          </details>
          <details class="faq-item">
            <summary class="faq-item__question">What if I need hosting and a domain?</summary>
            <p class="faq-item__answer">
              I recommend SiteGround for WordPress hosting (starts at $3.99/mo). Domains
              are typically $10-15/year. I'll help you set both up and configure everything.
              These costs are separate from my design fees and paid directly to the provider.
            </p>
          </details>
          <details class="faq-item">
            <summary class="faq-item__question">Do you work with international clients?</summary>
            <p class="faq-item__answer">
              Yes, I work with clients worldwide. All pricing is in USD. I accommodate
              different time zones for communication — most clients communicate via email
              or WhatsApp.
            </p>
          </details>
          <details class="faq-item">
            <summary class="faq-item__question">Can I upgrade my package later?</summary>
            <p class="faq-item__answer">
              Yes. You can add pages, features, or upgrade your maintenance plan at any time.
              Upgrade pricing is calculated as the difference between packages plus any
              additional work required.
            </p>
          </details>
          <details class="faq-item">
            <summary class="faq-item__question">What if I'm not happy with the design?</summary>
            <p class="faq-item__answer">
              I offer the revision rounds listed in each package to refine the design to your
              satisfaction. If after revisions you're still not satisfied, we'll discuss next
              steps. I've completed 100+ projects and this hasn't happened yet.
            </p>
          </details>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section">
    <div class="container" style="text-align:center;">
      <h2 class="section__title">Ready to start?</h2>
      <p class="section__subtitle" style="margin-bottom:var(--space-6);">
        Tell me about your project and I'll send a detailed quote within 24 hours.
      </p>
      <a href="/#contact" class="btn btn--primary btn--lg">Get a Free Quote</a>
    </div>
  </section>
</BaseLayout>

<style>
  /* ===== Page Header ===== */
  .page-header {
    padding-top: calc(var(--header-height) + var(--space-12));
    padding-bottom: var(--space-10);
    background: linear-gradient(180deg, #F0FDF4 0%, #FFFFFF 100%);
    text-align: center;
  }

  .page-header__badge {
    display: inline-block;
    background-color: var(--color-accent-light);
    color: var(--color-accent-dark);
    font-size: var(--text-sm);
    font-weight: 600;
    padding: var(--space-1) var(--space-3);
    border-radius: 999px;
    margin-bottom: var(--space-3);
  }

  .page-header__title { margin-bottom: var(--space-4); }

  .page-header__desc {
    max-width: 600px;
    margin-inline: auto;
    color: var(--color-text-secondary);
    font-size: var(--text-lg);
    line-height: 1.7;
  }

  /* ===== Tabs ===== */
  .pricing-tabs {
    display: flex;
    justify-content: center;
    gap: var(--space-2);
    margin-bottom: var(--space-10);
    flex-wrap: wrap;
  }

  .pricing-tab {
    padding: var(--space-3) var(--space-5);
    font-size: var(--text-sm);
    font-weight: 500;
    font-family: var(--font-body);
    color: var(--color-text-secondary);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .pricing-tab:hover {
    border-color: var(--color-primary-light);
    color: var(--color-primary);
  }

  .pricing-tab--active {
    background: var(--color-primary);
    color: white;
    border-color: var(--color-primary);
  }

  /* ===== Pricing Grid ===== */
  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
    align-items: start;
  }

  .pricing-grid--hidden { display: none; }

  /* ===== Pricing Card ===== */
  .pricing-card {
    position: relative;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    transition: all var(--transition-base);
  }

  .pricing-card:hover {
    border-color: var(--color-primary-light);
    box-shadow: var(--shadow-lg);
  }

  .pricing-card--popular {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-md);
    transform: scale(1.03);
  }

  .pricing-card--popular:hover {
    transform: scale(1.03) translateY(-2px);
  }

  .pricing-card__badge {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--color-primary);
    color: white;
    font-size: var(--text-xs);
    font-weight: 700;
    padding: var(--space-1) var(--space-4);
    border-radius: 999px;
    white-space: nowrap;
    letter-spacing: 0.02em;
  }

  .pricing-card__name {
    font-size: var(--text-xl);
    font-family: var(--font-display);
    color: var(--color-text);
  }

  .pricing-card__desc {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.6;
    min-height: 3.2em;
  }

  .pricing-card__price {
    display: flex;
    align-items: baseline;
    gap: var(--space-1);
  }

  .pricing-card__amount {
    font-size: 2.5rem;
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--color-text);
    line-height: 1;
  }

  .pricing-card__period {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    font-weight: 400;
  }

  .pricing-card__cta {
    justify-content: center;
    width: 100%;
  }

  .pricing-card__features {
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-4);
  }

  .pricing-card__features-title {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-3);
  }

  .pricing-card__features-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .pricing-card__features-list li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  .pricing-card__features-list svg {
    flex-shrink: 0;
    color: var(--color-accent);
    margin-top: 1px;
  }

  /* ===== Add-ons ===== */
  .addons {
    text-align: center;
  }

  .addons__label {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-primary);
    margin-bottom: var(--space-2);
  }

  .addons__title {
    margin-bottom: var(--space-2);
  }

  .addons__subtitle {
    color: var(--color-text-secondary);
    margin-bottom: var(--space-8);
  }

  .addons__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-3);
    max-width: 800px;
    margin-inline: auto;
  }

  .addon-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
    padding: var(--space-4);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .addon-item__name {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text);
  }

  .addon-item__price {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-primary);
    font-family: var(--font-display);
  }

  /* ===== Policies ===== */
  .policies {
    text-align: center;
  }

  .policies__label {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-primary);
    margin-bottom: var(--space-2);
  }

  .policies__title {
    margin-bottom: var(--space-8);
  }

  .policies__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-5);
    text-align: left;
  }

  .policy-card {
    padding: var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .policy-card__title {
    font-family: var(--font-display);
    font-size: var(--text-base);
    margin-bottom: var(--space-2);
    color: var(--color-text);
  }

  .policy-card__text {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.7;
  }

  /* ===== FAQ ===== */
  .faq-section {
    text-align: center;
  }

  .faq-section__label {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-primary);
    margin-bottom: var(--space-2);
  }

  .faq-section__title {
    margin-bottom: var(--space-8);
  }

  .faq-section__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
    text-align: left;
    max-width: 900px;
    margin-inline: auto;
  }

  .faq-item {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-4) var(--space-5);
  }

  .faq-item__question {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text);
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
  }

  .faq-item__question::-webkit-details-marker { display: none; }

  .faq-item__question::after {
    content: '+';
    font-size: var(--text-lg);
    font-weight: 400;
    color: var(--color-text-secondary);
    flex-shrink: 0;
    transition: transform var(--transition-fast);
  }

  .faq-item[open] .faq-item__question::after {
    content: '−';
    color: var(--color-primary);
  }

  .faq-item__answer {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin-top: var(--space-3);
  }

  /* ===== Responsive ===== */
  @media (max-width: 1024px) {
    .pricing-grid {
      grid-template-columns: 1fr;
      max-width: 480px;
      margin-inline: auto;
    }

    .pricing-card--popular {
      transform: none;
    }

    .pricing-card--popular:hover {
      transform: translateY(-2px);
    }

    .addons__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .policies__grid {
      grid-template-columns: 1fr;
    }

    .faq-section__grid {
      grid-template-columns: 1fr;
    }

    .addons__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>

<script>
  // Tab switching
  document.querySelectorAll('.pricing-tab').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var tabId = this.getAttribute('data-tab');

      // Update active tab
      document.querySelectorAll('.pricing-tab').forEach(function(b) {
        b.classList.remove('pricing-tab--active');
      });
      this.classList.add('pricing-tab--active');

      // Show matching grid
      document.querySelectorAll('[data-tab-content]').forEach(function(grid) {
        grid.classList.add('pricing-grid--hidden');
      });
      var activeGrid = document.querySelector('[data-tab-content="' + tabId + '"]');
      if (activeGrid) {
        activeGrid.classList.remove('pricing-grid--hidden');
      }
    });
  });
</script>
