<style>
  .hero {
    padding-top: calc(var(--header-height) + var(--space-20));
    padding-bottom: var(--space-24);
    background:
      radial-gradient(60% 55% at 50% 0%, rgba(59, 130, 246, 0.08), transparent 70%),
      linear-gradient(180deg, #EFF6FF 0%, #FFFFFF 100%);
    overflow: hidden;
    position: relative;
    isolation: isolate;
  }

  /* Dev grid — blueprint/IDE lines + graph-paper dots, drifts slowly */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image:
      linear-gradient(to right, rgba(30, 64, 175, 0.12) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(30, 64, 175, 0.12) 1px, transparent 1px),
      radial-gradient(circle, rgba(30, 64, 175, 0.22) 1.4px, transparent 1.8px);
    background-size: 56px 56px;
    /* Fade the grid toward the edges → soft glow in the centre + keeps text crisp */
    -webkit-mask-image: radial-gradient(125% 100% at 50% 12%, #000 0%, rgba(0, 0, 0, 0.65) 52%, transparent 88%);
            mask-image: radial-gradient(125% 100% at 50% 12%, #000 0%, rgba(0, 0, 0, 0.65) 52%, transparent 88%);
    animation: gridDrift 20s linear infinite;
    will-change: background-position;
  }

  /* Floating blue orb */
  .hero::after {
    content: '';
    position: absolute;
    z-index: 0;
    top: -30%;
    right: -10%;
    width: 700px;
    height: 700px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(59, 130, 246, 0.1) 0%, transparent 70%);
    animation: floatOrb 20s ease-in-out infinite;
  }

  /* Floating green orb */
  .hero__orb {
    position: absolute;
    z-index: 0;
    bottom: -20%;
    left: -5%;
    width: 500px;
    height: 500px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(22, 163, 74, 0.07) 0%, transparent 70%);
    animation: floatOrb 25s ease-in-out infinite reverse;
    pointer-events: none;
  }

  /* Mouse spotlight */
  .hero__spotlight {
    position: absolute;
    z-index: 1;
    width: 700px;
    height: 700px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(59, 130, 246, 0.12) 0%, transparent 60%);
    pointer-events: none;
    transform: translate(-50%, -50%);
    transition: opacity 0.3s;
  }

  @keyframes floatOrb {
    0%, 100% { transform: translate(0, 0) scale(1); }
    25% { transform: translate(40px, -30px) scale(1.05); }
    50% { transform: translate(-20px, 20px) scale(0.95); }
    75% { transform: translate(30px, 10px) scale(1.02); }
  }

  /* Slow diagonal drift — one full 56px tile, so it loops seamlessly */
  @keyframes gridDrift {
    from { background-position: 0 0; }
    to   { background-position: 56px 56px; }
  }

