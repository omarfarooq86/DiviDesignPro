---
interface PortfolioItem {
  title: string;
  category: string;
  description: string;
  url?: string;
  image: string;
}

const categories = [
  'All',
  'Outdoor Ads',
  'Medical',
  'Technology',
  'Wedding',
  'Logistics',
  'Services',
  'Education',
  'Adventure',
];

const items: PortfolioItem[] = [
  {
    title: 'Bray Outdoor Advertising',
    category: 'Outdoor Ads',
    description: 'Outdoor advertising company website built in Divi 5',
    url: 'https://brayoutdoor.com',
    image: '/portfolio/bray-outdoor.jpg',
  },
  {
    title: 'Dallas Billboards',
    category: 'Outdoor Ads',
    description: 'Another Ads website designed in Divi 5',
    url: 'https://www.dallasbillboards.com',
    image: '/portfolio/dallas-billboards.jpg',
  },
  {
    title: 'Medical Practice Site',
    category: 'Medical',
    description: 'Professional medical practice website with patient portal',
    image: '/portfolio/medical.jpg',
  },
  {
    title: 'Tech Startup Landing',
    category: 'Technology',
    description: 'SaaS landing page with modern UI and conversion optimization',
    image: '/portfolio/tech.jpg',
  },
  {
    title: 'Wedding Venue Site',
    category: 'Wedding',
    description: 'Elegant wedding venue showcase with gallery and booking',
    image: '/portfolio/wedding.jpg',
  },
  {
    title: 'Freight & Logistics',
    category: 'Logistics',
    description: 'Logistics company website with quote calculator',
    image: '/portfolio/logistics.jpg',
  },
  {
    title: 'Residential Services',
    category: 'Services',
    description: 'Home services company with service booking system',
    image: '/portfolio/residential.jpg',
  },
  {
    title: 'Chimney Services',
    category: 'Services',
    description: 'Specialized chimney service company with location pages',
    image: '/portfolio/chimney.jpg',
  },
  {
    title: 'Education Platform',
    category: 'Education',
    description: 'Online learning platform with course catalog',
    image: '/portfolio/education.jpg',
  },
  {
    title: 'Adventure Tours',
    category: 'Adventure',
    description: 'Adventure travel company with tour booking',
    image: '/portfolio/adventure.jpg',
  },
];
---

<section class="section" id="portfolio">
  <div class="container">
    <div class="section__header">
      <h2 class="section__title">Most Recent Divi Websites</h2>
      <p class="section__subtitle">
        A selection of 50+ Divi websites I've built across industries. Each site is
        custom-designed, mobile-responsive, speed-optimized, and SEO-ready.
      </p>
    </div>

    <div class="portfolio__filters" role="tablist" aria-label="Portfolio categories">
      {categories.map((cat) => (
        <button
          class="portfolio__filter"
          data-category={cat}
          role="tab"
          aria-selected={cat === 'All' ? 'true' : 'false'}
        >
          {cat}
        </button>
      ))}
    </div>

    <div class="portfolio__grid">
      {items.map((item) => (
        <a
          href={item.url || '#'}
          class="portfolio__item"
          data-category={item.category}
          {...(item.url ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
        >
          <div class="portfolio__item-image">
            <div class="portfolio__item-placeholder" aria-hidden="true">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <rect x="3" y="3" width="18" height="18" rx="2"/>
                <circle cx="8.5" cy="8.5" r="1.5"/>
                <polyline points="21 15 16 10 5 21"/>
              </svg>
            </div>
          </div>
          <div class="portfolio__item-info">
            <span class="portfolio__item-category">{item.category}</span>
            <h3 class="portfolio__item-title">{item.title}</h3>
            <p class="portfolio__item-desc">{item.description}</p>
          </div>
        </a>
      ))}
    </div>

    <div class="portfolio__cta">
      <p class="portfolio__cta-text">Want a site like these? Let's build yours.</p>
      <a href="#contact" class="btn btn--primary btn--lg">Get in Touch</a>
    </div>
  </div>
</section>

<style>
  .portfolio__filters {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
    margin-bottom: var(--space-10);
  }

  .portfolio__filter {
    padding: var(--space-2) var(--space-4);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-gray-600);
    background-color: var(--color-gray-100);
    border: none;
    border-radius: 999px;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .portfolio__filter:hover,
  .portfolio__filter[aria-selected="true"] {
    background-color: var(--color-primary);
    color: var(--color-white);
  }

  .portfolio__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6);
  }

  .portfolio__item {
    display: flex;
    flex-direction: column;
    background-color: var(--color-white);
    border: 1px solid var(--color-gray-100);
    border-radius: var(--radius-xl);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: all var(--transition-base);
    cursor: pointer;
  }

  .portfolio__item:hover {
    border-color: var(--color-primary-light);
    box-shadow: var(--shadow-lg);
    transform: translateY(-2px);
  }

  .portfolio__item-image {
    aspect-ratio: 16 / 10;
    background-color: var(--color-gray-50);
    overflow: hidden;
  }

  .portfolio__item-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-gray-300);
  }

  .portfolio__item-info {
    padding: var(--space-4) var(--space-5);
  }

  .portfolio__item-category {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .portfolio__item-title {
    font-size: var(--text-base);
    margin-top: var(--space-1);
    margin-bottom: var(--space-1);
  }

  .portfolio__item-desc {
    font-size: var(--text-sm);
    color: var(--color-gray-500);
    line-height: 1.5;
  }

  .portfolio__cta {
    text-align: center;
    margin-top: var(--space-12);
    padding: var(--space-10);
    background: linear-gradient(135deg, var(--color-primary-light), #faf5ff);
    border-radius: var(--radius-2xl);
  }

  .portfolio__cta-text {
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--color-gray-800);
    margin-bottom: var(--space-4);
  }

  @media (max-width: 768px) {
    .portfolio__grid {
      grid-template-columns: 1fr;
    }

    .portfolio__filters {
      gap: var(--space-1);
    }

    .portfolio__filter {
      font-size: var(--text-xs);
      padding: var(--space-1) var(--space-3);
    }
  }
</style>

<script>
  // Simple category filter
  document.querySelectorAll('.portfolio__filter').forEach((btn) => {
    btn.addEventListener('click', () => {
      const category = btn.getAttribute('data-category');

      // Update active state
      document.querySelectorAll('.portfolio__filter').forEach((b) => {
        b.setAttribute('aria-selected', 'false');
      });
      btn.setAttribute('aria-selected', 'true');

      // Filter items
      document.querySelectorAll('.portfolio__item').forEach((item) => {
        const itemCategory = item.getAttribute('data-category');
        if (category === 'All' || itemCategory === category) {
          (item as HTMLElement).style.display = '';
        } else {
          (item as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>
