---
interface PortfolioItem {
  title: string;
  description: string;
  url?: string;
  image: string;
}

interface PortfolioCategory {
  name: string;
  icon: string;
  items: PortfolioItem[];
}

const portfolioData: PortfolioCategory[] = [
  {
    name: 'Home Services & Contractors',
    icon: '🏠',
    items: [
      {
        title: 'Apex Plumbing',
        description: 'Emergency plumbing services in Powder Springs, GA',
        url: 'https://www.emergencyplumbersatlanta.com',
        image: '/portfolio/emergency-plumbers.webp',
      },
      {
        title: 'Shepard Painting Solutions',
        description: 'Residential & commercial painting in Canton, OH',
        url: 'https://shepardpaintingsolutions.com',
        image: '/portfolio/shepard-painting.webp',
      },
      {
        title: 'Leonard & Sons',
        description: 'Chimney sweep & fireplace repair in Chicagoland, IL',
        url: 'https://leonardandsons.com',
        image: '/portfolio/leonard-sons.webp',
      },
      {
        title: 'My Bat Guy',
        description: 'Bat & wildlife removal services in Oakland County, MI',
        url: 'https://www.batremovalandprevention.com',
        image: '/portfolio/bat-removal.webp',
      },
      {
        title: 'The Chimney Doctor',
        description: 'Chimney sweep & fireplace repair in Memphis, TN',
        url: 'https://www.thechimneydoctor.com',
        image: '/portfolio/chimney-doctor.webp',
      },
      {
        title: 'Sweeps & Ladders',
        description: 'Chimney sweep & fireplace repair in Nashville & Franklin, TN',
        url: 'https://www.sweepsandladders.com',
        image: '/portfolio/sweeps-ladders.webp',
      },
    ],
  },
  {
    name: 'Business & Professional Services',
    icon: '💼',
    items: [
      {
        title: 'Bray Outdoor Advertising',
        description: 'SoCal outdoor advertising agency website built in Divi 5',
        url: 'https://brayoutdoor.com',
        image: '/portfolio/bray-outdoor.webp',
      },
      {
        title: 'Dallas Billboards',
        description: 'DFW billboard advertising agency designed in Divi 5',
        url: 'https://www.dallasbillboards.com',
        image: '/portfolio/dallas-billboards.webp',
      },
      {
        title: 'CB3 Freight Logistics',
        description: 'Reliable freight services company website',
        url: 'https://cb3freightlogistics.com',
        image: '/portfolio/cb3-freight.webp',
      },
      {
        title: 'NoFrills Dental',
        description: 'Affordable family dentistry clinic in Singapore',
        url: 'https://www.nofrillsdental.com',
        image: '/portfolio/nofrills-dental.webp',
      },
      {
        title: 'Oxford Scholastica',
        description: 'Oxford summer school & online courses platform',
        url: 'https://www.oxfordscholastica.com',
        image: '/portfolio/oxford-scholastica.webp',
      },
    ],
  },
  {
    name: 'Lifestyle, Travel & E-Commerce',
    icon: '🌍',
    items: [
      {
        title: 'Hawaii By Storm',
        description: 'Maui private luxury tours website',
        url: 'https://hawaiibystorm.com',
        image: '/portfolio/hawaii-by-storm.webp',
      },
      {
        title: 'Overland Adventures',
        description: 'Luxury Land Rover Defender camper hire in the UK',
        url: 'https://overland-adventures.co.uk',
        image: '/portfolio/overland-adventures.webp',
      },
      {
        title: 'Snoop Dogg',
        description: 'Official website for the legendary artist',
        url: 'https://snoopdogg.com',
        image: '/portfolio/snoop-dogg.webp',
      },
      {
        title: 'Tetto Rooftop',
        description: 'Rooftop cocktail bar & events venue in Brisbane, Australia',
        url: 'https://tettorooftop.com.au',
        image: '/portfolio/tetto-rooftop.webp',
      },
    ],
  },
];

const totalItems = portfolioData.reduce((sum, cat) => sum + cat.items.length, 0);
---

<section class="section" id="portfolio">
  <div class="container">
    <div class="section__header">
      <h2 class="section__title">Most Recent Divi Websites</h2>
      <p class="section__subtitle">
        A selection of {totalItems}+ Divi websites I've built across {portfolioData.length} industries.
        Each site is custom-designed, mobile-responsive, speed-optimized, and SEO-ready.
      </p>
    </div>

    <div class="portfolio-accordion">
      {portfolioData.map((category, index) => (
        <details class="accordion-section" open={index === 0}>
          <summary class="accordion-header">
            <span class="accordion-icon">{category.icon}</span>
            <span class="accordion-title">{category.name}</span>
            <span class="accordion-count">{category.items.length} site{category.items.length !== 1 ? 's' : ''}</span>
            <svg class="accordion-chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"/>
            </svg>
          </summary>
          <div class="accordion-body">
            <div class="portfolio-grid">
              {category.items.map((item) => (
                <a
                  href={item.url || '#'}
                  class="portfolio-card"
                  {...(item.url ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                >
                  <div class="portfolio-card__image">
                    <img
                      src={item.image}
                      alt={`${item.title} — ${item.description}`}
                      loading="lazy"
                      decoding="async"
                      width="640"
                      height="400"
                    />
                  </div>
                  <div class="portfolio-card__info">
                    <h3 class="portfolio-card__title">{item.title}</h3>
                    <p class="portfolio-card__desc">{item.description}</p>
                  </div>
                </a>
              ))}
            </div>
          </div>
        </details>
      ))}
    </div>

    <div class="portfolio__cta">
      <p class="portfolio__cta-text">Want a site like these? Let's build yours.</p>
      <a href="#contact" class="btn btn--primary btn--lg">Get in Touch</a>
    </div>
  </div>
</section>

<style>
  /* ===== Accordion ===== */
  .portfolio-accordion {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .accordion-section {
    background-color: var(--color-white);
    border: 1px solid var(--color-gray-100);
    border-radius: var(--radius-xl);
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .accordion-section[open] {
    border-color: var(--color-primary-light);
    box-shadow: var(--shadow-md);
  }

  .accordion-header {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-5);
    cursor: pointer;
    user-select: none;
    list-style: none;
    font-weight: 600;
    color: var(--color-gray-800);
    transition: background-color var(--transition-fast);
    border-radius: var(--radius-xl);
  }

  .accordion-header::-webkit-details-marker {
    display: none;
  }

  .accordion-header:hover {
    background-color: var(--color-gray-50);
  }

  .accordion-icon {
    font-size: 1.25rem;
    flex-shrink: 0;
  }

  .accordion-title {
    font-size: var(--text-base);
    flex: 1;
  }

  .accordion-count {
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--color-gray-400);
    background-color: var(--color-gray-100);
    padding: var(--space-1) var(--space-2);
    border-radius: 999px;
  }

  .accordion-chevron {
    flex-shrink: 0;
    color: var(--color-gray-400);
    transition: transform var(--transition-fast);
  }

  .accordion-section[open] .accordion-chevron {
    transform: rotate(180deg);
    color: var(--color-primary);
  }

  .accordion-body {
    padding: 0 var(--space-5) var(--space-5);
  }

  /* ===== Grid ===== */
  .portfolio-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
  }

  /* ===== Card ===== */
  .portfolio-card {
    display: flex;
    flex-direction: column;
    background-color: var(--color-white);
    border: 1px solid var(--color-gray-100);
    border-radius: var(--radius-lg);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: all var(--transition-base);
    cursor: pointer;
  }

  .portfolio-card:hover {
    border-color: var(--color-primary-light);
    box-shadow: var(--shadow-lg);
    transform: translateY(-2px);
  }

  .portfolio-card__image {
    aspect-ratio: 16 / 10;
    background-color: var(--color-gray-50);
    overflow: hidden;
  }

  .portfolio-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .portfolio-card:hover .portfolio-card__image img {
    transform: scale(1.03);
  }

  .portfolio-card__info {
    padding: var(--space-3) var(--space-4);
  }

  .portfolio-card__title {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-gray-800);
    margin-bottom: 2px;
  }

  .portfolio-card__desc {
    font-size: var(--text-xs);
    color: var(--color-gray-500);
    line-height: 1.5;
  }

  /* ===== CTA ===== */
  .portfolio__cta {
    text-align: center;
    margin-top: var(--space-12);
    padding: var(--space-10);
    background: linear-gradient(135deg, var(--color-primary-light), #faf5ff);
    border-radius: var(--radius-2xl);
  }

  .portfolio__cta-text {
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--color-gray-800);
    margin-bottom: var(--space-4);
  }

  @media (max-width: 768px) {
    .portfolio-grid {
      grid-template-columns: 1fr;
    }

    .accordion-header {
      padding: var(--space-3) var(--space-4);
    }

    .accordion-body {
      padding: 0 var(--space-4) var(--space-4);
    }
  }
</style>

<script>
  // Only one accordion section open at a time
  document.querySelectorAll('.accordion-section').forEach(function(detail) {
    detail.addEventListener('toggle', function() {
      if (this.open) {
        document.querySelectorAll('.accordion-section').forEach(function(other) {
          if (other !== detail) other.open = false;
        });
      }
    });
  });
</script>
