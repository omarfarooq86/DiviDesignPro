---
import { business, addressLines } from '../data/business';

const address = addressLines();
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__grid">
      <div class="footer__brand">
        <a href="/" class="footer__logo">
          <img src="/logo.png" alt="DiviDesignPro" class="footer__logo-img" width="179" height="100" />
        </a>
        <p class="footer__tagline">
          AI-accelerated WordPress development. Websites built in days, not weeks. Freelance Divi &amp; WordPress specialist with 10+ years of experience.
        </p>
        <div class="footer__social">
          <a href="https://www.facebook.com/divithemesolution" target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="footer__social-link">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
          <a href="mailto:contact@dividesignpro.com" aria-label="Email" class="footer__social-link">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M22 4L12 13 2 4"/></svg>
          </a>
        </div>
      </div>

      <div class="footer__col">
        <h2 class="footer__heading">Services</h2>
        <ul class="footer__links">
          <li><a href="/services/">All Services</a></li>
          <li><a href="/services/hire-wordpress-developer/">Hire a WordPress Developer</a></li>
          <li><a href="/services/web-design-lahore/">Web Design in Lahore</a></li>
          <li><a href="/services/ai-web-development/">AI-Powered Web Development</a></li>
          <li><a href="/pricing/">Care Plans &amp; Pricing</a></li>
        </ul>
      </div>

      <div class="footer__col">
        <h2 class="footer__heading">Resources</h2>
        <ul class="footer__links">
          <li><a href="/pricing/">Pricing</a></li>
          <li><a href="/blog/">Blog</a></li>
          <li><a href="/portfolio/">Portfolio</a></li>
          <li><a href="/#faq">FAQ</a></li>
          <li><a href="/#testimonials">Testimonials</a></li>
        </ul>
      </div>

      <div class="footer__col">
        <h2 class="footer__heading">Contact</h2>
        <ul class="footer__links">
          <li><a href="mailto:contact@dividesignpro.com">contact@dividesignpro.com</a></li>
          <li><a href="tel:+923101418307">+92 310 1418307</a></li>
          <li><a href="tel:+13074453714">+1 (307) 445-3714</a></li>
          <li><a href="/#contact">Get a Quote</a></li>
<li><a href="https://www.elegantthemes.com/affiliates/idevaffiliate.php?id=81533" target="_blank" rel="sponsored noopener">Get Divi</a></li>
        </ul>
        <address class="footer__address">
          {address.map((line) => <span class="footer__address-line">{line}</span>)}
        </address>
      </div>
    </div>

    <div class="footer__legal">
      <h2 class="footer__heading">Legal</h2>
      <ul class="footer__legal-links">
        <li><a href="/privacy-policy/">Privacy Policy</a></li>
        <li><a href="/terms-and-conditions/">Terms and Conditions</a></li>
        <li><a href="/refund-policy/">Refund &amp; Cancellation Policy</a></li>
        <li><a href="/ownership-statement/">Ownership Statement</a></li>
      </ul>
    </div>

    <div class="footer__bottom">
      <p>&copy; {year} {business.legalName}, trading as {business.tradingAs}. All rights reserved.</p>
      <p class="footer__disclaimer">Divi is a registered trademark of Elegant Themes, Inc. This site is not affiliated with or endorsed by Elegant Themes.</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: #0F172A;
    color: #CBD5E1;
    padding-block: var(--space-16) var(--space-8);
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: var(--space-10);
    margin-bottom: var(--space-12);
  }

  .footer__logo {
    font-size: var(--text-2xl);
    font-weight: 700;
    font-family: var(--font-display);
    color: #FFFFFF;
    text-decoration: none;
  }

  .footer__logo-img {
    height: 100px;
    width: auto;
    filter: brightness(0) invert(1);
    opacity: 0.9;
  }

  .footer__tagline {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    color: #94A3B8;
    max-width: 320px;
  }

  .footer__social {
    display: flex;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .footer__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    min-width: 44px;
    min-height: 44px;
    border-radius: var(--radius-md);
    background-color: rgb(255 255 255 / 0.08);
    color: #94A3B8;
    transition: all var(--transition-fast);
  }

  .footer__social-link:hover {
    background-color: var(--color-primary);
    color: #FFFFFF;
  }

  .footer__heading {
    color: #FFFFFF;
    font-size: var(--text-sm);
    font-weight: 600;
    font-family: var(--font-body);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: var(--space-4);
  }

  .footer__links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .footer__links a {
    color: #94A3B8;
    font-size: var(--text-sm);
    font-family: var(--font-body);
    text-decoration: none;
    transition: color var(--transition-fast);
    overflow-wrap: break-word;
    word-break: break-word;
  }

  .footer__links a:hover { color: #FFFFFF; }

  .footer__address {
    margin-top: var(--space-4);
    font-style: normal;
    font-size: var(--text-sm);
    color: #64748B;
    line-height: 1.6;
  }

  .footer__address-line { display: block; }

  .footer__legal {
    border-top: 1px solid rgb(255 255 255 / 0.08);
    padding-top: var(--space-6);
    margin-bottom: var(--space-6);
  }

  .footer__legal-links {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
  }

  .footer__legal-links a {
    color: #94A3B8;
    font-size: var(--text-sm);
    font-family: var(--font-body);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .footer__legal-links a:hover { color: #FFFFFF; }

  .footer__bottom {
    border-top: 1px solid rgb(255 255 255 / 0.08);
    padding-top: var(--space-6);
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: var(--text-sm);
    color: #64748B;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .footer__disclaimer { font-size: var(--text-xs); }

  @media (max-width: 768px) {
    .footer__grid { grid-template-columns: 1fr 1fr; }
    .footer__brand { grid-column: 1 / -1; }
    .footer__bottom { flex-direction: column; text-align: center; }
  }
</style>
