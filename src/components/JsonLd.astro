---
import { business } from '../data/business';

interface Props {
  type:
    | 'Person'
    | 'WebSite'
    | 'Article'
    | 'BreadcrumbList'
    | 'FAQ'
    | 'LocalBusiness'
    | 'Organization'
    | 'Service';
  data?: Record<string, any>;
}

const { type, data = {} } = Astro.props;

/** Stable @id values so nodes can cross-reference each other in the graph. */
const BUSINESS_ID = `${business.siteUrl}/#business`;
const ORGANIZATION_ID = `${business.siteUrl}/#organization`;

/** The Lahore address, shared by every schema that publishes a location. */
function postalAddress() {
  return {
    '@type': 'PostalAddress',
    streetAddress: `${business.address.line1}, ${business.address.line2}`,
    addressLocality: business.address.city,
    addressRegion: business.address.region,
    postalCode: business.address.postalCode,
    addressCountry: 'PK',
  };
}

/** Resolve a relative upload path against siteUrl, matching SEOMeta's behaviour. */
function absolute(pathOrUrl: string) {
  return pathOrUrl.startsWith('http') ? pathOrUrl : `${business.siteUrl}${pathOrUrl}`;
}

function getPersonSchema() {
  return {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': `${business.siteUrl}/#person`,
    name: business.legalName,
    alternateName: business.tradingAs,
    url: business.siteUrl,
    jobTitle: 'Freelance Divi Designer & WordPress Developer',
    email: business.email,
    telephone: [business.phoneLocal.href, business.phoneInternational.href],
    address: postalAddress(),
    sameAs: [...business.sameAs],
    knowsAbout: ['WordPress', 'Divi Theme', 'Web Design', 'SEO', 'Frontend Development'],
  };
}

function getWebSiteSchema() {
  return {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${business.siteUrl}/#website`,
    name: business.displayName,
    url: business.siteUrl,
    description: business.description,
    inLanguage: 'en',
    publisher: { '@id': ORGANIZATION_ID },
  };
}

function getArticleSchema() {
  return {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: data.title,
    description: data.description,
    image: data.image?.startsWith('/') ? `https://www.dividesignpro.com${data.image}` : data.image,
    datePublished: data.datePublished,
    dateModified: data.dateModified || data.datePublished,
    author: {
      '@type': 'Person',
      name: 'DiviDesignPro',
      url: 'https://www.dividesignpro.com',
    },
    publisher: {
      '@type': 'Person',
      name: 'DiviDesignPro',
    },
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': data.url,
    },
  };
}

function getBreadcrumbSchema() {
  return {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: data.items.map((item: { name: string; url: string }, index: number) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.name,
      item: item.url,
    })),
  };
}

function getFAQSchema() {
  const mainEntity = data.questions.map((q: { question: string; answer: string }) => ({
    '@type': 'Question',
    name: q.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: q.answer,
    },
  }));

  return {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity,
  };
}

function getLocalBusinessSchema() {
  return {
    '@context': 'https://schema.org',
    // ProfessionalService is the most specific subtype that fits a freelance
    // web developer; LocalBusiness is kept alongside it for broader coverage.
    '@type': ['ProfessionalService', 'LocalBusiness'],
    '@id': BUSINESS_ID,
    name: business.displayName,
    legalName: business.legalName,
    url: business.siteUrl,
    description: business.description,
    email: business.email,
    telephone: business.phoneLocal.href,
    image: absolute(business.ogImage),
    logo: absolute(business.logo),
    priceRange: business.priceRange,
    address: postalAddress(),
    areaServed: [...business.areaServed],
    sameAs: [...business.sameAs],
    openingHoursSpecification: business.openingHours.map((slot) => ({
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: [...slot.days].map((day) => `https://schema.org/${day}`),
      opens: slot.opens,
      closes: slot.closes,
    })),
  };
}

function getOrganizationSchema() {
  return {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': ORGANIZATION_ID,
    name: business.displayName,
    legalName: business.legalName,
    url: business.siteUrl,
    description: business.description,
    logo: {
      '@type': 'ImageObject',
      url: absolute(business.logo),
    },
    image: absolute(business.ogImage),
    email: business.email,
    telephone: business.phoneLocal.href,
    address: postalAddress(),
    sameAs: [...business.sameAs],
    founder: {
      '@type': 'Person',
      '@id': `${business.siteUrl}/#person`,
      name: business.legalName,
    },
  };
}

function getServiceSchema() {
  return {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: data.name,
    description: data.description,
    serviceType: data.serviceType,
    url: data.url,
    provider: {
      '@type': 'ProfessionalService',
      '@id': BUSINESS_ID,
      name: business.displayName,
      url: business.siteUrl,
    },
    areaServed: data.areaServed ? [...data.areaServed] : [...business.areaServed],
  };
}

const schemas: Record<string, () => object> = {
  Person: getPersonSchema,
  WebSite: getWebSiteSchema,
  Article: getArticleSchema,
  BreadcrumbList: getBreadcrumbSchema,
  FAQ: getFAQSchema,
  LocalBusiness: getLocalBusinessSchema,
  Organization: getOrganizationSchema,
  Service: getServiceSchema,
};

const schema = schemas[type] ? schemas[type]() : null;
---

{schema && (
  <script type="application/ld+json" set:html={JSON.stringify(schema, null, 2)} />
)}
