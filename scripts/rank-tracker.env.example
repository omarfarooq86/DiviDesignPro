# Copy to rank-tracker.env and fill in. That file is gitignored.
#
# Find your API password at https://app.dataforseo.com/api-access
# (this is the API password, not your account login password).
#
# The account these credentials belong to is the same one the DataForSEO
# session already uses, so the balance is shared.

DATAFORSEO_LOGIN=you@example.com
DATAFORSEO_PASSWORD=your-api-password
